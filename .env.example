# --- AI provider (optional — blueprint refinement only; core works without it) ---
# OpenAI-compatible chat-completions endpoint used ONLY to polish the objective sentence.
# Structure always comes from the local validator. Leave unset to run fully offline.
AI_GATEWAY_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Buy / x402 payments (server-side ONLY — never prefix with NEXT_PUBLIC_) ---
# Payment is executed by the OFFICIAL @celo/buy client (pinned in src/lib/x402pay.ts).
# Sandbox (Celo Sepolia, test funds): create once with
#   BUY_HOME=.buy-keystore BUY_KEYSTORE_BACKEND=file npx --yes @celo/buy@0.8.4 setup --name speak2agent --network sepolia
# The gateway faucet auto-funds 1 test USDC/day; larger offers fail the balance check.
BUY_ACCOUNT=speak2agent
BUY_HOME=.buy-keystore
BUY_KEYSTORE_BACKEND=file
# Mainnet (real funds): run `npx @celo/buy setup --name <agent>` with the OS keychain,
# fund a SMALL dedicated float, then set CELO_NETWORK=mainnet + BUY_ACCOUNT=<agent>.
# Never commit keys. Never log keys. Never send keys to the browser.
# testnet (Celo Sepolia, default) or mainnet. Testnet success is never shown as mainnet activity.
CELO_NETWORK=testnet
NEXT_PUBLIC_CELO_NETWORK=testnet

# --- Hackathon attribution (from https://www.loops.house/agents-on-open-rails enrollment) ---
HACKATHON_ATTRIBUTION_TAG=
NEXT_PUBLIC_HACKATHON_ATTRIBUTION_TAG=

# --- ERC-8004 identity (do NOT guess — fill from the official registry deployment) ---
NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY=
NEXT_PUBLIC_ERC8004_REPUTATION_REGISTRY=

# --- x402 facilitator API key (server-side; for future seller endpoints) ---
X402_API_KEY=
